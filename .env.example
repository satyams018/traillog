# Copy to .env and fill in. Never commit .env.

# --- Django ---
DJANGO_SECRET_KEY=change-me-generate-a-long-random-string
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:4173
# Apple Silicon Homebrew paths (leave unset on Linux/CI)
GDAL_LIBRARY_PATH=/opt/homebrew/lib/libgdal.dylib
GEOS_LIBRARY_PATH=/opt/homebrew/lib/libgeos_c.dylib

# --- Database (postgis:// selects the GeoDjango backend) ---
DATABASE_URL=postgis://traillog:traillog@localhost:5432/traillog

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
# Cache (login rate limits etc.). Unset = per-process memory, fine for CI only.
CACHE_URL=rediscache://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=false

# --- Object storage (SeaweedFS locally, Cloudflare R2 in prod) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=traillog
S3_SECRET_ACCESS_KEY=traillog-dev-secret
S3_BUCKET=traillog
S3_REGION=auto

# --- Email (console in dev) ---
# The site's address; links in emails (verify email, reset password) point here.
FRONTEND_URL=http://localhost:5173
ACCOUNT_EMAIL_VERIFICATION=optional
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# --- Frontend (Vite exposes only VITE_* vars to the browser) ---
# Get a free key at maptiler.com and restrict it to your domains.
# Without a key the map falls back to the keyless OpenFreeMap style.
VITE_MAPTILER_KEY=

# --- Local dev test account (created by hand on localhost; not used anywhere else) ---
# email: demo@traillog.test  username: demo  password: Trek-Demo-2026!
